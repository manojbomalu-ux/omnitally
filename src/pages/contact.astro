---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us">
  <div class="mx-auto max-w-2xl py-16 px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-center mb-8">Contact Us</h1>
    <div class="prose mx-auto">
      <p>We value your feedback and are here to help with any questions you may have about our calculators.</p>
      <h2 class="text-2xl font-semibold mt-6 mb-4">Email Support</h2>
      <p>For general inquiries, please email us at: <a href="mailto:info@calculatorsuite.com" class="text-blue-600 hover:underline">info@calculatorsuite.com</a></p>
      <h2 class="text-2xl font-semibold mt-6 mb-4">Feedback & Suggestions</h2>
      <p>Have an idea for a new calculator or see something that could be improved? Let us know!</p>
      <h2 class="text-2xl font-semibold mt-6 mb-4">Privacy Notice</h2>
      <p>We respect your privacy. Our calculators run entirely in your browser and we do not collect, store, or share any personal information you enter into our tools.</p>
      <p><a href="/privacy" class="text-blue-600 hover:underline">Read our Privacy Policy</a></p>
    </div>
  </div>
</Layout>