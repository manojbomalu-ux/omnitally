---
import Layout from '../layouts/Layout.astro';
import toolsData from '../data/tools.json';

const allTools = Array.isArray(toolsData) ? toolsData : (toolsData.tools || []);
---
<Layout title="Free Online Financial & Business Calculators | OmniTally">
  <div class="mx-auto max-w-6xl py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold text-center mb-8">Free Online Financial & Business Calculators | OmniTally</h1>
    <p class="text-center text-gray-600 mb-8 max-w-2xl mx-auto">
      Fast, accurate, client-side calculators for loan payments, investment returns, retirement savings, taxes, and more—all free and instant.
    </p>

    <!-- Programmatic Tools Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {allTools.map((tool) => (
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition">
          <div class="p-6 flex flex-col h-full justify-between">
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-2">{tool.title}</h2>
              <p class="text-gray-600 text-sm mb-4">
                Calculate {tool.title.toLowerCase().replace('calculator', '').trim()} with our accurate and easy-to-use tool.
              </p>
            </div>
            <a
              href={`/tools/${tool.slug}`}
              class="inline-block text-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded transition-colors"
            >
              Use Calculator &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- How It Works Section -->
    <div class="mt-16 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-semibold text-center mb-8">How It Works</h2>
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="h-12 w-12 mx-auto bg-blue-100 rounded-full flex items-center justify-center mb-4">
            <span class="text-blue-600 font-bold text-lg">1</span>
          </div>
          <h3 class="text-lg font-medium mb-2">Select a Calculator</h3>
          <p class="text-sm text-gray-600">
            Choose from our collection of financial, conversion, and sizing calculators.
          </p>
        </div>
        <div class="text-center">
          <div class="h-12 w-12 mx-auto bg-blue-100 rounded-full flex items-center justify-center mb-4">
            <span class="text-blue-600 font-bold text-lg">2</span>
          </div>
          <h3 class="text-lg font-medium mb-2">Enter Your Values</h3>
          <p class="text-sm text-gray-600">
            Input your numbers and see real-time calculated results instantly in your browser.
          </p>
        </div>
        <div class="text-center">
          <div class="h-12 w-12 mx-auto bg-blue-100 rounded-full flex items-center justify-center mb-4">
            <span class="text-blue-600 font-bold text-lg">3</span>
          </div>
          <h3 class="text-lg font-medium mb-2">Share & Bookmark</h3>
          <p class="text-sm text-gray-600">
            Copy the updated URL at any time to save or share your exact calculation inputs.
          </p>
        </div>
      </div>
    </div>

    <!-- Trust & Value Grid -->
    <div class="mt-16 text-center">
      <h2 class="text-2xl font-semibold mb-8">Why Use Our Calculators?</h2>
      <div class="max-w-4xl mx-auto grid gap-4 sm:grid-cols-2 lg:grid-cols-4 text-left">
        <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
          <div class="h-8 w-8 flex items-center justify-center bg-blue-100 text-blue-600 font-bold rounded-full mb-3">✓</div>
          <h3 class="font-semibold text-gray-900 mb-1">100% Free</h3>
          <p class="text-xs text-gray-600">No account creation, downloads, or payment required.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
          <div class="h-8 w-8 flex items-center justify-center bg-blue-100 text-blue-600 font-bold rounded-full mb-3">✓</div>
          <h3 class="font-semibold text-gray-900 mb-1">Standard Formulas</h3>
          <p class="text-xs text-gray-600">Grounded in proven mathematical and financial formulas.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
          <div class="h-8 w-8 flex items-center justify-center bg-blue-100 text-blue-600 font-bold rounded-full mb-3">✓</div>
          <h3 class="font-semibold text-gray-900 mb-1">Client-Side Speed</h3>
          <p class="text-xs text-gray-600">Zero backend delays; computations execute instantaneously.</p>
        </div>
        <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-sm">
          <div class="h-8 w-8 flex items-center justify-center bg-blue-100 text-blue-600 font-bold rounded-full mb-3">✓</div>
          <h3 class="font-semibold text-gray-900 mb-1">Mobile Optimized</h3>
          <p class="text-xs text-gray-600">Responsive layouts tailored for any screen or device.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>